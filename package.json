{
  "name": "vue-carbonbadge",
  "private": false,
  "version": "2.0.3-0",
  "description": "Vue component for the Website Carbon Badge",
  "author": "Niklas Haug",
  "license": "MIT",
  "keywords": [
    "vue",
    "vue-cli",
    "websitecarbon",
    "carbonbadge"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/niklashaug/vue-carbonbadge.git"
  },
  "bugs": "https://github.com/niklashaug/vue-carbonbadge/issues",
  "main": "./dist/vue-carbonbadge.umd.cjs",
  "module": "./dist/vue-carbonbadge.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/vue-carbonbadge.js",
      "require": "./dist/vue-carbonbadge.umd.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc && vite build",
    "preview": "vite preview",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "website-carbon-badges": "^1.1.3"
  },
  "peerDependencies": {
    "vue": "^3.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "eslint": "^9.17.0",
    "eslint-plugin-vue": "^9.32.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.6",
    "vite-plugin-dts": "^4.4.0",
    "vue": "^3.5.30",
    "vue-tsc": "^2.2.0"
  },
  "volta": {
    "node": "24.14.0"
  }
}
